<UserControl x:Class="VB6VisualMockupDesigner.Controls.DesignerCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>

        <DrawingBrush x:Key="GridPatternBrush" Viewport="0,0,8,8" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,8,0.5" />
                            <RectangleGeometry Rect="0,0,0.5,8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#707070" Opacity="0.5"/>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="RetroWinBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Background" Value="#D4D0C8"/>
            <Setter Property="Margin" Value="2,2,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="1,1,0,0">
                            <Border BorderBrush="#404040" BorderThickness="0,0,1,1">
                                <Border BorderBrush="#808080" BorderThickness="0,0,1,1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormGripStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>

        <ContextMenu x:Key="ControlContextMenu" Opened="ContextMenu_Opened" BorderThickness="0">
            <MenuItem Header="Cortar" Click="MnuCut_Click" InputGestureText="Ctrl+X">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copiar" Click="MnuCopy_Click" InputGestureText="Ctrl+C">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Pegar" Click="MnuPaste_Click" InputGestureText="Ctrl+V">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Eliminar" Click="MnuDelete_Click" InputGestureText="Supr">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem x:Name="MnuLockItem" Header="Bloquear Controles" Click="MnuLock_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Traer al Frente" Click="MnuBringToFront_Click"/>
            <MenuItem Header="Enviar al Fondo" Click="MnuSendToBack_Click"/>
        </ContextMenu>

    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackground}">
        <ScrollViewer x:Name="MainScrollViewer" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto" 
                      Background="Transparent">

            <Grid x:Name="DesignGrid" Width="2000" Height="2000" 
                  Background="Transparent" 
                  MouseLeftButtonDown="DesignSurface_MouseDown">

                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>

                <Grid x:Name="WindowResizerGrid" 
                      Width="480" Height="360"
                      VerticalAlignment="Top" 
                      HorizontalAlignment="Left">

                    <Border x:Name="RetroFormContainer"
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch"
                            Background="#D4D0C8"
                            BorderThickness="2">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5" Color="Black"/>
                        </Border.Effect>

                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#404040" Offset="0.501"/>
                                <GradientStop Color="#404040" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Margin="2,2,2,0"
                                    MouseLeftButtonDown="FormTitle_MouseDown"
                                    MouseLeftButtonUp="FormTitle_MouseUp"
                                    MouseMove="FormTitle_MouseMove"
                                    Background="Transparent">
                                <Grid>
                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#000080" Offset="0"/>
                                                <GradientStop Color="#1084D0" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Source="/Resource/icon.ico" Width="14" Margin="2,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                        <TextBlock x:Name="FormTitleText" Grid.Column="1" Text="Form1" 
                                                   Foreground="White" FontWeight="Bold" FontSize="11" 
                                                   VerticalAlignment="Center" Margin="2,0,0,0" FontFamily="Microsoft Sans Serif"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,2,2">
                                            <Button Style="{StaticResource RetroWinBtnStyle}">
                                                <Path Data="M0,4 L6,4" Stroke="Black" StrokeThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                            <Button Style="{StaticResource RetroWinBtnStyle}">
                                                <Border BorderBrush="Black" BorderThickness="1,1,0,0" Width="9" Height="8"/>
                                            </Button>
                                            <Button Style="{StaticResource RetroWinBtnStyle}" Margin="2,2,0,0">
                                                <Path Data="M1,1 L7,7 M7,1 L1,7" Stroke="Black" StrokeThickness="1"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="2">
                                <Canvas x:Name="DesignSurface" 
                                        Background="Transparent" 
                                        ClipToBounds="True"
                                        AllowDrop="True" 
                                        DragOver="DesignSurface_DragOver"
                                        Drop="DesignSurface_Drop"
                                        MouseDown="DesignSurface_MouseDown"
                                        MouseMove="DesignSurface_MouseMove" 
                                        MouseUp="DesignSurface_MouseUp"
                                        ContextMenu="{StaticResource ControlContextMenu}">

                                    <Rectangle x:Name="SelectionRect"
                                               Stroke="{DynamicResource AccentColor}"
                                               StrokeThickness="1"
                                               Fill="#336495ED"
                                               Visibility="Collapsed"
                                               IsHitTestVisible="False"
                                               Panel.ZIndex="9999"/>

                                    <TextBox x:Name="QuickEditBox"
                                             Visibility="Collapsed"
                                             Panel.ZIndex="999999"
                                             Background="White"
                                             Foreground="Black"
                                             BorderBrush="#0078D7"
                                             BorderThickness="1"
                                             Padding="2"
                                             AcceptsReturn="True" 
                                             LostFocus="QuickEditBox_LostFocus"
                                             PreviewKeyDown="QuickEditBox_PreviewKeyDown"/>
                                    <Popup x:Name="InfoTip" 
                                           Placement="Relative"
                                           AllowsTransparency="True"
                                           IsHitTestVisible="False">
                                        <Border Background="#FFFFE1" 
                                                BorderBrush="Black" 
                                                BorderThickness="1" 
                                                Padding="4,2"
                                                CornerRadius="0">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="2" Opacity="0.3" BlurRadius="5"/>
                                            </Border.Effect>
                                            <TextBlock x:Name="InfoTipText" 
                                                       Text="X: 0, Y: 0" 
                                                       FontSize="11" 
                                                       FontFamily="Segoe UI"
                                                       Foreground="Black"/>
                                        </Border>
                                    </Popup>
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid x:Name="FormResizeHandles" Panel.ZIndex="5000">
                        <Rectangle Style="{StaticResource FormGripStyle}" Tag="TopLeft" Cursor="SizeNWSE"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-3,0,0"
                                   MouseLeftButtonDown="ResizeForm_MouseDown" MouseLeftButtonUp="ResizeForm_MouseUp" MouseMove="ResizeForm_MouseMove"/>
                        <Rectangle Style="{StaticResource FormGripStyle}" Tag="Top" Cursor="SizeNS"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-3,0,0"
                                   MouseLeftButtonDown="ResizeForm_MouseDown" MouseLeftButtonUp="ResizeForm_MouseUp" MouseMove="ResizeForm_MouseMove"/>
                        <Rectangle Style="{StaticResource FormGripStyle}" Tag="TopRight" Cursor="SizeNESW"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                   MouseLeftButtonDown="ResizeForm_MouseDown" MouseLeftButtonUp="ResizeForm_MouseUp" MouseMove="ResizeForm_MouseMove"/>
                        <Rectangle Style="{StaticResource FormGripStyle}" Tag="Right" Cursor="SizeWE"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-3,0"
                                   MouseLeftButtonDown="ResizeForm_MouseDown" MouseLeftButtonUp="ResizeForm_MouseUp" MouseMove="ResizeForm_MouseMove"/>
                        <Rectangle Style="{StaticResource FormGripStyle}" Tag="BottomRight" Cursor="SizeNWSE"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                   MouseLeftButtonDown="ResizeForm_MouseDown" MouseLeftButtonUp="ResizeForm_MouseUp" MouseMove="ResizeForm_MouseMove"/>
                        <Rectangle Style="{StaticResource FormGripStyle}" Tag="Bottom" Cursor="SizeNS"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-3"
                                   MouseLeftButtonDown="ResizeForm_MouseDown" MouseLeftButtonUp="ResizeForm_MouseUp" MouseMove="ResizeForm_MouseMove"/>
                        <Rectangle Style="{StaticResource FormGripStyle}" Tag="BottomLeft" Cursor="SizeNESW"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3,0,0,-3"
                                   MouseLeftButtonDown="ResizeForm_MouseDown" MouseLeftButtonUp="ResizeForm_MouseUp" MouseMove="ResizeForm_MouseMove"/>
                        <Rectangle Style="{StaticResource FormGripStyle}" Tag="Left" Cursor="SizeWE"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-3,0,0,0"
                                   MouseLeftButtonDown="ResizeForm_MouseDown" MouseLeftButtonUp="ResizeForm_MouseUp" MouseMove="ResizeForm_MouseMove"/>
                    </Grid>

                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>