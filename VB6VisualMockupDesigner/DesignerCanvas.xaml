<UserControl x:Class="VB6VisualMockupDesigner.DesignerCanvas"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>

        <DrawingBrush x:Key="GridPatternBrush" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="10,10" RadiusX="1" RadiusY="1" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#404040"/>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        
        <!--
            Usar si no quieres fondo de puntos
        -->

        <!--<DrawingBrush x:Key="GridPatternBrush" Viewport="0,0,8,8" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="1,1" RadiusX="0.5" RadiusY="0.5"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#404040"/>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>-->



        <Style x:Key="RetroWinBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Background" Value="#D4D0C8"/>
            <Setter Property="Margin" Value="2,2,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="1,1,0,0">
                            <Border BorderBrush="#404040" BorderThickness="0,0,1,1">
                                <Border BorderBrush="#808080" BorderThickness="0,0,1,1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <ScrollViewer x:Name="MainScrollViewer" 
                  HorizontalScrollBarVisibility="Auto" 
                  VerticalScrollBarVisibility="Auto" 
                  Background="Transparent">

            <Grid x:Name="DesignGrid" Width="1000" Height="1000" Background="{StaticResource GridPatternBrush}" MouseLeftButtonDown="Grid_MouseLeftButtonDown">

                <Border x:Name="RetroFormContainer" 
                        Width="480" Height="360"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#D4D0C8"
                        BorderThickness="2">
                    <!-- Background="Transparent"-->

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5" Color="Black"/>
                    </Border.Effect>

                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#404040" Offset="0.501"/>
                            <GradientStop Color="#404040" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Margin="2,2,2,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#000080" Offset="0"/>
                                    <GradientStop Color="#1084D0" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="/Assets/form_icon.png" Width="14" Margin="2,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="FormTitleText" Grid.Column="1" Text="Form1" 
                                           Foreground="White" FontWeight="Bold" FontSize="11" 
                                           VerticalAlignment="Center" Margin="2,0,0,0" FontFamily="Microsoft Sans Serif"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,2,2">
                                    <Button Style="{StaticResource RetroWinBtnStyle}">
                                        <Path Data="M0,4 L6,4" Stroke="Black" StrokeThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource RetroWinBtnStyle}">
                                        <Border BorderBrush="Black" BorderThickness="1,1,0,0" Width="9" Height="8"/>
                                    </Button>
                                    <Button Style="{StaticResource RetroWinBtnStyle}" Margin="2,2,0,0">
                                        <Path Data="M1,1 L7,7 M7,1 L1,7" Stroke="Black" StrokeThickness="1"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="2">
                            <Canvas x:Name="DesignSurface" 
                                Background="{StaticResource GridPatternBrush}" 
                                ClipToBounds="True"
                                AllowDrop="True"  
                                Drop="DesignSurface_Drop"
                                    MouseDown="DesignSurface_MouseDown"
                                    >
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>

                <Rectangle Width="6" Height="6" Fill="White" Stroke="Black" VerticalAlignment="Center" HorizontalAlignment="Center" 
                           Margin="486, 0, 0, 366"/>
                <Rectangle Width="6" Height="6" Fill="White" Stroke="Black" VerticalAlignment="Center" HorizontalAlignment="Center" 
                           Margin="486, 366, 0, 0"/>
                <Rectangle Width="6" Height="6" Fill="White" Stroke="Black" VerticalAlignment="Center" HorizontalAlignment="Center" 
                           Margin="0, 366, 0, 0"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>