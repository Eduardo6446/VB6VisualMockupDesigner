<Window x:Class="VB6VisualMockupDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VB6VisualMockupDesigner"
        mc:Ignorable="d"

        Title="VB6 Visual Mockup Designer - Prototipe" Height="450" Width="800"
        Background="#D4D0C8" Icon="/icon.ico">



    <Window.Resources>
        <!-- Estilo para los botones de la Toolbox (Cuadrícula de Iconos) -->
        <Style x:Key="ToolboxButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#D4D0C8"/>
            <Setter Property="BorderBrush" Value="#808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para los botones de la Barra Superior (Menú) -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="BorderBrush" Value="#808080"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Fondo de puntos para el Canvas (Estilo VB6) -->
        <VisualBrush x:Key="VB6GridBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <VisualBrush.Visual>
                <Canvas>
                    <Ellipse Fill="#BCBCBC" Width="1" Height="1" Margin="0"/>
                </Canvas>
            </VisualBrush.Visual>
        </VisualBrush>
    </Window.Resources>

    <!-- GRID PRINCIPAL -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Fila 0: Barra de Herramientas -->
            <RowDefinition Height="*"/>
            <!-- Fila 1: Área de Trabajo -->
        </Grid.RowDefinitions>

        <!-- BARRA DE HERRAMIENTAS SUPERIOR -->
        <Border Grid.Row="0" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="0,0,0,1" Padding="4">
            <StackPanel Orientation="Horizontal">
                <Button Content="📂 Importar .FRM" Click="ImportFrm_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Abrir archivo .frm existente"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>
                <Button Content="💾 Exportar Código" Click="ExportCode_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Generar código VB6"/>
                <Button Content="🖼️ Guardar Imagen" Click="ExportImage_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Guardar como PNG"/>
            </StackPanel>
        </Border>

        <!-- ÁREA DE TRABAJO (3 Columnas) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- TOOLBOX (Izquierda) -->
            <Border Grid.Column="0" Background="#E0E0E0" BorderBrush="#BCBCBC" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True" Margin="8">
                    <TextBlock Text="Controles VB6" DockPanel.Dock="Top" Style="{StaticResource HeaderTextStyle}" Margin="0,10,0,5"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <UniformGrid Columns="2" VerticalAlignment="Top">
                            <!-- Puntero -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="Pointer">
                                <Path Data="M2,2 L10,18 L13,13 L18,13 Z" Fill="Black" Stretch="Uniform" Margin="4"/>
                            </Button>

                            <!-- PictureBox -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="PictureBox" Click="AddPictureBox_Click">
                                <Canvas Width="20" Height="16">
                                    <Rectangle Width="20" Height="16" Stroke="Black" StrokeThickness="1"/>
                                    <Polyline Points="2,14 8,6 12,10 15,4 18,14" Stroke="Black" StrokeThickness="1"/>
                                </Canvas>
                            </Button>

                            <!-- Label -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="Label" Click="AddLabel_Click">
                                <TextBlock Text="A" FontSize="18" FontWeight="Bold" FontFamily="Serif" HorizontalAlignment="Center"/>
                            </Button>

                            <!-- TextBox -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="TextBox" Click="AddTextBox_Click">
                                <Border BorderBrush="Black" BorderThickness="1" Width="22" Height="14" Background="White">
                                    <TextBlock Text="ab" FontSize="8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </Button>

                            <!-- Frame -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="Frame" Click="AddFrame_Click">
                                <Border BorderBrush="Gray" BorderThickness="1" Width="24" Height="20">
                                    <TextBlock Text="xyz" FontSize="6" VerticalAlignment="Top" Margin="2,0,0,0"/>
                                </Border>
                            </Button>

                            <!-- CommandButton -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="CommandButton" Click="AddButton_Click">
                                <Border BorderBrush="Black" BorderThickness="1" Width="20" Height="14" Background="#D4D0C8" CornerRadius="1"/>
                            </Button>

                            <!-- CheckBox -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="CheckBox" Click="AddCheckBox_Click">
                                <Grid Width="12" Height="12">
                                    <Border BorderBrush="Black" BorderThickness="1" Background="White"/>
                                    <Path Data="M2,6 L5,9 L10,2" Stroke="Black" StrokeThickness="1.5"/>
                                </Grid>
                            </Button>

                            <!-- OptionButton -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="OptionButton" Click="AddOptionButton_Click">
                                <Grid Width="12" Height="12">
                                    <Ellipse Stroke="Black" StrokeThickness="1" Fill="White"/>
                                    <Ellipse Fill="Black" Width="4" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- ComboBox -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="ComboBox" Click="AddComboBox_Click">
                                <Border BorderBrush="Black" BorderThickness="1" Width="22" Height="12" Background="White">
                                    <Path Data="M14,2 L14,10 M15,4 L18,4 L16.5,7 Z" Fill="Black" Stroke="Black" StrokeThickness="0.5"/>
                                </Border>
                            </Button>

                            <!-- ListBox -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="ListBox" Click="AddListBox_Click">
                                <Border BorderBrush="Black" BorderThickness="1" Width="20" Height="20" Background="White">
                                    <StackPanel Margin="2">
                                        <Rectangle Height="1" Fill="Black" Margin="0,1"/>
                                        <Rectangle Height="1" Fill="Black" Margin="0,1"/>
                                        <Rectangle Height="1" Fill="Black" Margin="0,1"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- HScrollBar -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="HScrollBar" Click="AddHScrollBar_Click">
                                <Border BorderBrush="Black" BorderThickness="1" Width="24" Height="10">
                                    <Grid>
                                        <Rectangle Width="4" HorizontalAlignment="Left" Fill="Gray"/>
                                        <Rectangle Width="4" HorizontalAlignment="Right" Fill="Gray"/>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- VScrollBar -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="VScrollBar" Click="AddVScrollBar_Click">
                                <Border BorderBrush="Black" BorderThickness="1" Width="10" Height="24">
                                    <Grid>
                                        <Rectangle Height="4" VerticalAlignment="Top" Fill="Gray"/>
                                        <Rectangle Height="4" VerticalAlignment="Bottom" Fill="Gray"/>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Timer -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="Timer" Click="AddTimer_Click">
                                <Grid Width="18" Height="18">
                                    <Ellipse Stroke="Black" StrokeThickness="1"/>
                                    <Path Data="M9,4 L9,9 L12,12" Stroke="Black" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- DriveListBox -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="DriveListBox" Click="AddDriveListBox_Click">
                                <Path Data="M2,14 L18,14 L18,6 L10,6 L8,4 L2,4 Z" Fill="Transparent" Stroke="Black" StrokeThickness="1" Margin="4"/>
                            </Button>

                            <!-- DirListBox -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="DirListBox" Click="AddDirListBox_Click">
                                <Path Data="M4,4 L16,4 L16,14 L4,14 Z M6,6 L14,6 M6,9 L14,9" Fill="Transparent" Stroke="Black" StrokeThickness="1" Margin="4"/>
                            </Button>

                            <!-- FileListBox -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="FileListBox" Click="AddFileListBox_Click">
                                <Path Data="M4,2 L12,2 L16,6 L16,18 L4,18 Z" Fill="Transparent" Stroke="Black" StrokeThickness="1" Margin="4"/>
                            </Button>

                            <!-- Shape -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="Shape" Click="AddShape_Click">
                                <Rectangle Width="16" Height="16" Stroke="Black" StrokeThickness="1" StrokeDashArray="2,2"/>
                            </Button>

                            <!-- Line -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="Line" Click="AddLine_Click">
                                <Line X1="2" Y1="18" X2="18" Y2="2" Stroke="Black" StrokeThickness="1"/>
                            </Button>

                            <!-- Image -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="Image" Click="AddImage_Click">
                                <Path Data="M4,4 L16,16 M4,16 L16,4" Stroke="Gray" StrokeThickness="1" Margin="4"/>
                            </Button>

                            <!-- NUEVO: Menu Bar -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="Menu Bar" Click="AddMenu_Click">
                                <Border BorderBrush="Black" BorderThickness="0,0,0,1" Width="28" Height="20" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" Margin="2,2,0,0">
                                        <Rectangle Width="6" Height="2" Fill="Black" Margin="1"/>
                                        <Rectangle Width="6" Height="2" Fill="Black" Margin="1"/>
                                        <Rectangle Width="6" Height="2" Fill="Black" Margin="1"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- NUEVO: Status Bar -->
                            <Button Style="{StaticResource ToolboxButtonStyle}" ToolTip="Status Bar" Click="AddStatusBar_Click">
                                <Border BorderBrush="Black" BorderThickness="1" Width="28" Height="20">
                                    <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Height="6" VerticalAlignment="Bottom" Background="#D4D0C8">
                                        <Grid>
                                            <Rectangle Width="2" Height="4" HorizontalAlignment="Right" Fill="Gray" Margin="0,0,4,0"/>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Button>

                        </UniformGrid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- CANVAS (Centro) -->
            <Border Grid.Column="1" Background="#808080" Padding="20">
                <Border CornerRadius="4" Background="White">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.3" ShadowDepth="5"/>
                    </Border.Effect>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <!-- El Canvas tiene todos los eventos de ratón necesarios para selección múltiple -->
                        <Canvas Name="DesignCanvas" 
                                Width="800" Height="600" 
                                Background="{StaticResource VB6GridBrush}"
                                MouseDown="DesignCanvas_MouseDown"
                                MouseMove="DesignCanvas_MouseMove"
                                MouseUp="DesignCanvas_MouseUp">
                            <!-- Rectángulo invisible para el lazo de selección -->
                            <Rectangle x:Name="SelectionBox" 
                                       Stroke="#3399FF" 
                                       StrokeThickness="1" 
                                       Fill="#330000FF" 
                                       Visibility="Collapsed"
                                       Panel.ZIndex="9999"/>
                        </Canvas>
                    </ScrollViewer>
                </Border>
            </Border>

            <!-- PANEL DE PROPIEDADES (Derecha) -->
            <Border Grid.Column="2" Background="#E0E0E0" BorderBrush="#BCBCBC" BorderThickness="1,0,0,0">
                <DockPanel Margin="0">
                    <Border DockPanel.Dock="Top" Background="#D4D0C8" Padding="10" BorderBrush="#BCBCBC" BorderThickness="0,0,0,1">
                        <TextBlock Name="PropHeaderTitle" Text="Properties - Form1" FontWeight="Bold"/>
                    </Border>

                    <ScrollViewer>
                        <Border Padding="10">
                            <StackPanel>
                                <Expander Header="Appearance" IsExpanded="True" Margin="0,0,0,10">
                                    <Grid Margin="5,10,5,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="(Name)" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                                        <TextBox Name="PropName" Grid.Row="0" Grid.Column="1" Margin="2" Padding="2" BorderBrush="#BCBCBC" TextChanged="PropName_TextChanged"/>

                                        <TextBlock Name="LabelPropCaption" Text="Caption" Grid.Row="1" VerticalAlignment="Center" Margin="0,4"/>
                                        <TextBox Name="PropCaption" Grid.Row="1" Grid.Column="1" Margin="2" Padding="2" BorderBrush="#BCBCBC" TextChanged="PropCaption_TextChanged"/>
                                    </Grid>
                                </Expander>

                                <Expander Header="Position" IsExpanded="True">
                                    <Grid Margin="5,10,5,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Left (twips)" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                                        <TextBox Name="PropLeft" Grid.Row="0" Grid.Column="1" Margin="2" Padding="2" Background="White" IsReadOnly="True"/>

                                        <TextBlock Text="Top (twips)" Grid.Row="1" VerticalAlignment="Center" Margin="0,4"/>
                                        <TextBox Name="PropTop" Grid.Row="1" Grid.Column="1" Margin="2" Padding="2" Background="White" IsReadOnly="True"/>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>

</Window>
