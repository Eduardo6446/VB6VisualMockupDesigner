<Window x:Class="VB6VisualMockupDesigner.MainWindowModern"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:VB6VisualMockupDesigner"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VB6 Visual Mockup Designer" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{DynamicResource BgColor}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome 
            CaptionHeight="32"  
            ResizeBorderThickness="5" 
            CornerRadius="0"
            GlassFrameThickness="1"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>


        <Style TargetType="Separator">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border BorderBrush="{TemplateBinding Background}" 
                            BorderThickness="1" 
                            Height="1" 
                            SnapsToDevicePixels="true"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopMenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Grid>
                                    <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        Padding="{TemplateBinding Padding}" 
                                        SnapsToDevicePixels="True">
                                        <ContentPresenter ContentSource="Header" 
                                                      VerticalAlignment="Center" 
                                                      HorizontalAlignment="Left"
                                                      RecognizesAccessKey="True"/>
                                    </Border>

                                    <Popup x:Name="Popup" Placement="Bottom" 
                                       IsOpen="{TemplateBinding IsSubmenuOpen}" 
                                       AllowsTransparency="True" 
                                       Focusable="False" 
                                       PopupAnimation="Fade">
                                        <Border x:Name="SubmenuBorder" SnapsToDevicePixels="True" 
                                            Background="#1E1E1E" 
                                            BorderBrush="#3E3E42" 
                                            BorderThickness="1" 
                                            Padding="2">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="10,5">
                                    <DockPanel>
                                        <ContentPresenter ContentSource="Icon" Margin="0,0,10,0" Width="16" Height="16"/>
                                        <ContentPresenter ContentSource="Header"/>
                                        <TextBlock Text="{TemplateBinding InputGestureText}" 
                                               Foreground="#888888" Margin="20,0,0,0" 
                                               HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#005A9E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActivityBarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextColor}"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Indicator" Width="2" HorizontalAlignment="Left" Background="Transparent"/>
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Indicator" Property="Background" Value="{StaticResource BrandColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" 
                                    Foreground="#CCCCCC" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#454545"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VsCodeTabStyle" TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#969696"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="TopIndicator" VerticalAlignment="Top" Height="1" Background="Transparent" Panel.ZIndex="10"/>
                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="#252526" BorderThickness="0,0,1,0" Padding="10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{TemplateBinding Foreground}" Margin="0,1,5,0" FontSize="12"/>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                    <Button x:Name="CloseBtn" Style="{StaticResource TabCloseBtnStyle}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="TopIndicator" Property="Background" Value="{StaticResource BrandColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">

        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                        <Setter Property="Margin" Value="8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>


        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource BgColor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Menu Grid.Column="0" Style="{StaticResource TopMenuStyle}" 
              VerticalAlignment="Center" Margin="5,0,0,0"
              WindowChrome.IsHitTestVisibleInChrome="True">
                <MenuItem Header="Archivo">
                    <MenuItem Header="Nuevo Proyecto..." Click="BtnNew_Click"/>
                    <MenuItem Header="Abrir..." Click="BtnOpen_Click"/>
                    <Separator Background="{StaticResource BorderColor}"/>
                    <MenuItem Header="Cerrar Proyecto" Click="BtnCloseProject_Click"/>
                    <MenuItem Header="Salir" Click="BtnClose_Click"/>
                </MenuItem>
                <MenuItem Header="Editar">
                    <MenuItem Header="Deshacer"/>
                    <MenuItem Header="Rehacer"/>
                </MenuItem>
                <MenuItem Header="Ver">
                    <MenuItem Header="Caja de Herramientas"/>
                    <MenuItem Header="Explorador de Proyectos"/>
                </MenuItem>
                <MenuItem Header="Ayuda">
                    <MenuItem Header="Acerca de..."/>
                </MenuItem>
            </Menu>

            <TextBlock Grid.Column="1" Text="VB6 Visual Mockup Designer" 
                   Foreground="{StaticResource MutedTextColor}" FontSize="12"
                   VerticalAlignment="Center" HorizontalAlignment="Center" 
                   IsHitTestVisible="False"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="&#xE921;" Style="{StaticResource WindowControlButtonStyle}" Click="BtnMinimize_Click"/>
                <Button Content="&#xE922;" Style="{StaticResource WindowControlButtonStyle}" Click="BtnMaximize_Click" x:Name="BtnMaximize"/>
                <Button Content="&#xE8BB;" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{StaticResource BorderColor}"/>


        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource SideBarColor}">
                <StackPanel>
                    <ToggleButton Style="{StaticResource ActivityBarToggleStyle}" 
                                  Content="&#xE8B7;" ToolTip="Explorador de Proyectos (Ctrl+Shift+E)"
                                  Click="ActivityBar_Click" Tag="Explorer"/>
                    <ToggleButton Style="{StaticResource ActivityBarToggleStyle}" 
                                  Content="&#xe152;" ToolTip="Caja de Herramientas (Ctrl+Shift+X)"
                                  Click="ActivityBar_Click" Tag="Toolbox"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Width="1" Background="{StaticResource BorderColor}"/>
            </Grid>

            <Grid Grid.Column="1" x:Name="SideBarContainer" Background="{StaticResource SideBarColor}" Width="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="SideBarTitle" 
                           Text="EXPLORADOR" Foreground="{StaticResource MutedTextColor}" 
                           FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>

                <ContentControl Grid.Row="1" x:Name="SideBarContent" Margin="10">
                    <TextBlock Text="Contenido del panel..." Foreground="#888888"/>
                </ContentControl>

                <Border Grid.RowSpan="2" HorizontalAlignment="Right" Width="1" Background="{StaticResource BorderColor}"/>
            </Grid>

            <Grid Grid.Column="2" Background="{StaticResource BgColor}">
                <Grid x:Name="EmptyStateOverlay" Panel.ZIndex="0">
                    <TextBlock Text="&#xE70C;" FontFamily="Segoe MDL2 Assets" 
                               FontSize="150" Foreground="{StaticResource HoverColor}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Opacity="0.3"/>
                    <TextBlock Text="Selecciona un archivo del explorador para editar" 
                               Foreground="#666666" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,200,0,0"/>
                </Grid>

                <TabControl x:Name="MainTabControl" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="0"
                            ItemContainerStyle="{StaticResource VsCodeTabStyle}"
                            Visibility="Hidden">
                </TabControl>
            </Grid>

            <local:PropertiesPanel x:Name="PropertiesPanel" 
                                   Grid.Column="3" 
                                   BorderBrush="#3E3E42" 
                                   BorderThickness="1,0,0,0"/>
        </Grid>
        <StatusBar Grid.Row="2" Background="#007ACC" Foreground="White" Padding="10,0">
            <StatusBarItem>
                <TextBlock Text="Listo"/>
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ln 1, Col 1" Margin="0,0,15,0"/>
                    <TextBlock Text="VB6 Mockup"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
