<Window x:Class="VB6VisualMockupDesigner.MainWindowModern"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:VB6VisualMockupDesigner"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VB6 Visual Mockup Designer" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{DynamicResource BgColor}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome 
            CaptionHeight="32"  
            ResizeBorderThickness="5" 
            CornerRadius="0"
            GlassFrameThickness="1"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border BorderBrush="{TemplateBinding Background}" 
                            BorderThickness="1" 
                            Height="1" 
                            SnapsToDevicePixels="true"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopMenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Grid>
                                    <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            Padding="{TemplateBinding Padding}" 
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter ContentSource="Header" 
                                                          VerticalAlignment="Center" 
                                                          HorizontalAlignment="Left"
                                                          RecognizesAccessKey="True"/>
                                    </Border>

                                    <Popup x:Name="Popup" Placement="Bottom" 
                                           IsOpen="{TemplateBinding IsSubmenuOpen}" 
                                           AllowsTransparency="True" 
                                           Focusable="False" 
                                           PopupAnimation="Fade">
                                        <Border x:Name="SubmenuBorder" SnapsToDevicePixels="True" 
                                                Background="#1E1E1E" 
                                                BorderBrush="#3E3E42" 
                                                BorderThickness="1" 
                                                Padding="2">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="10,5">
                                    <DockPanel>
                                        <ContentPresenter ContentSource="Icon" Margin="0,0,10,0" Width="16" Height="16"/>
                                        <ContentPresenter ContentSource="Header"/>
                                        <TextBlock Text="{TemplateBinding InputGestureText}" 
                                                   Foreground="#888888" Margin="20,0,0,0" 
                                                   HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#005A9E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActivityBarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextColor}"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Indicator" Width="2" HorizontalAlignment="Left" Background="Transparent"/>
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Indicator" Property="Background" Value="{StaticResource BrandColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" 
                                       Foreground="#CCCCCC" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#454545"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VsCodeTabStyle" TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#969696"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="TopIndicator" VerticalAlignment="Top" Height="1" Background="Transparent" Panel.ZIndex="10"/>
                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="#252526" BorderThickness="0,0,1,0" Padding="10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{TemplateBinding Foreground}" Margin="0,1,5,0" FontSize="12"/>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                    <Button x:Name="CloseBtn" Style="{StaticResource TabCloseBtnStyle}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="TopIndicator" Property="Background" Value="{StaticResource BrandColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarSeparator" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>


        <Style x:Key="ToolbarToggleBtnStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                        <Setter Property="Margin" Value="8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource BgColor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" 
                  Orientation="Horizontal" 
                  VerticalAlignment="Center" 
                  Margin="10,0,0,0"
                  WindowChrome.IsHitTestVisibleInChrome="True">

                <Image Source="/Resource/icon.ico"
                 Width="18" Height="18"
                 Margin="0,0,2,0"
                 VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.3"/>
                    </Image.Effect>
                </Image>

                <Menu Style="{StaticResource TopMenuStyle}" Background="Transparent">
                    <MenuItem Header="Archivo">
                        <MenuItem Header="Nuevo Proyecto..." Click="BtnNew_Click"/>
                        <MenuItem Header="Abrir..." Click="BtnOpen_Click"/>
                        <Separator Background="{StaticResource BorderColor}"/>
                        <MenuItem Header="Guardar" InputGestureText="Ctrl+S" Click="MnuSave_Click"/>
                        <MenuItem Header="Guardar como..." Click="MnuSaveAs_Click"/>
                        <MenuItem Header="Exportar a Imagen" Click="MnuExportPng_Click"/>
                        <Separator Background="{StaticResource BorderColor}"/>
                        <MenuItem Header="Cerrar Pestaña" Click="BtnCloseProject_Click"/>
                        <MenuItem Header="Salir" Click="BtnClose_Click"/>
                    </MenuItem>
                    <MenuItem Header="Editar">
                        <MenuItem Header="Deshacer" Click="BtnUndo_Click"/>
                        <MenuItem Header="Rehacer" Click="BtnRedo_Click"/>
                    </MenuItem>
                    <MenuItem Header="Ver">
                        <MenuItem Header="Propiedades" Click="MnuShowProperties_Click"/>
                        <MenuItem Header="Vista Auxiliar" Click="MnuShowAux_Click"/>
                    </MenuItem>
                    <MenuItem Header="Ayuda">
                        <MenuItem Header="Acerca de..." Click="BtnAbout_Click"/>
                    </MenuItem>
                </Menu>
            </StackPanel>

            <Grid Grid.Column="1" 
      HorizontalAlignment="Center" 
      VerticalAlignment="Center" 
      Width="400"
      WindowChrome.IsHitTestVisibleInChrome="True">

                <Border x:Name="SearchContainer" 
            Background="#3C3C3C" 
            CornerRadius="4" 
            BorderBrush="#555" 
            BorderThickness="1"
            Height="24">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Foreground="#CCCCCC" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                        <TextBox x:Name="TxtGlobalSearch" Grid.Column="1"
                     Background="Transparent" BorderThickness="0"
                     Foreground="White" CaretBrush="White"
                     FontSize="12" VerticalContentAlignment="Center"
                     Padding="0,0,5,2"
                     TextChanged="TxtGlobalSearch_TextChanged"
                     PreviewKeyDown="TxtGlobalSearch_PreviewKeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock IsHitTestVisible="False" Text="Buscar (Ctrl+P)" FontSize="12"
                       Grid.Column="1" VerticalAlignment="Center" Foreground="#888888" Margin="2,0,0,1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtGlobalSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Popup x:Name="SearchPopup" 
           PlacementTarget="{Binding ElementName=SearchContainer}" 
           Placement="Bottom" 
           StaysOpen="False" 
           AllowsTransparency="True" 
           PopupAnimation="Slide" 
           Width="400">

                    <Border Background="#252526" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="4" MaxHeight="300" Margin="0,2,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.5"/>
                        </Border.Effect>

                        <ListBox x:Name="LstSearchResults" 
                     Background="Transparent" BorderThickness="0" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="LstSearchResults_MouseDoubleClick"
                     PreviewKeyDown="LstSearchResults_PreviewKeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="Foreground" Value="#CCCCCC"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#2A2D2E"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding IconCode}" FontFamily="Segoe MDL2 Assets" 
                                       Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#4EC9B0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding FullPath}" FontSize="10" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="&#xE921;" Style="{StaticResource WindowControlButtonStyle}" Click="BtnMinimize_Click"/>
                <Button Content="&#xE922;" Style="{StaticResource WindowControlButtonStyle}" Click="BtnMaximize_Click" x:Name="BtnMaximize"/>
                <Button Content="&#xE8BB;" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{StaticResource BorderColor}"/>

        <Border Grid.Row="1" Background="{StaticResource BgColor}" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center">

                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Guardar (Ctrl+S)" Click="MnuSave_Click">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Guardar todo">
                    <TextBlock Text="&#xE78C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Deshacer (Ctrl+Z)" Click="BtnUndo_Click">
                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Rehacer (Ctrl+Y)" Click="BtnRedo_Click">
                    <TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Cortar (Ctrl+X)" Click="BtnCut_Click">
                    <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Copiar (Ctrl+C)" Click="BtnCopy_Click">
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Pegar (Ctrl+V)" Click="BtnPaste_Click">
                    <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Eliminar (Supr)" Click="BtnDelete_Click">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Alinear a la Izquierda" Click="BtnAlignLeft_Click">
                    <Path Data="M2,2 H4 V14 H2 Z M6,4 H14 V7 H6 Z M6,9 H12 V12 H6 Z" Fill="#F1F1F1" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Alinear al Centro" Click="BtnAlignCenter_Click">
                    <Path Data="M7,2 H9 V14 H7 Z M3,4 H13 V7 H3 Z M4,9 H12 V12 H4 Z" Fill="#F1F1F1" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Alinear a la Derecha" Click="BtnAlignRight_Click">
                    <Path Data="M12,2 H14 V14 H12 Z M2,4 H10 V7 H2 Z M4,9 H10 V12 H4 Z" Fill="#F1F1F1" Width="14" Height="14" Stretch="Uniform"/>
                </Button>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Alinear Arriba" Click="BtnAlignTop_Click">
                    <Path Data="M2,2 V4 H14 V2 Z M4,6 V14 H7 V6 Z M9,6 V12 H12 V6 Z" Fill="#F1F1F1" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Alinear al Medio" Click="BtnAlignMiddle_Click">
                    <Path Data="M2,7 V9 H14 V7 Z M4,2 V14 H7 V2 Z M9,4 V12 H12 V4 Z" Fill="#F1F1F1" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Alinear Abajo" Click="BtnAlignBottom_Click">
                    <Path Data="M2,12 V14 H14 V12 Z M4,2 V10 H7 V2 Z M9,4 V10 H12 V4 Z" Fill="#F1F1F1" Width="14" Height="14" Stretch="Uniform"/>
                </Button>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Igualar Ancho" Click="BtnSameWidth_Click">
                    <Path Data="M2,4 H6 V12 H2 Z M9,2 H13 V14 H9 Z M7,8 L9,8 M6,8 L4,8" Stroke="#F1F1F1" StrokeThickness="1"/>
                </Button>
                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Igualar Alto" Click="BtnSameHeight_Click">
                    <Path Data="M2,9 V13 H14 V9 Z M4,2 V6 H12 V2 Z" Stroke="#F1F1F1" StrokeThickness="1"/>
                </Button>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Traer al Frente" Click="BtnBringToFront_Click">
                    <Grid Width="16" Height="16">
                        <Rectangle Width="10" Height="10" Fill="#666" Margin="0,0,6,6"/>
                        <Rectangle Width="10" Height="10" Fill="#F1F1F1" Stroke="#333" StrokeThickness="1" Margin="4,4,0,0"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Enviar al Fondo" Click="BtnSendToBack_Click">
                    <Grid Width="16" Height="16">
                        <Rectangle Width="10" Height="10" Fill="#F1F1F1" Stroke="#333" StrokeThickness="1" Margin="0,0,6,6"/>
                        <Rectangle Width="10" Height="10" Fill="#666" Stroke="#333" StrokeThickness="1" Margin="4,4,0,0"/>
                    </Grid>
                </Button>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <ToggleButton Style="{StaticResource ToolbarToggleBtnStyle}" 
              ToolTip="Editar Orden de Tabulación" 
              Click="BtnTabOrder_Click">
                    <TextBlock Text="&#xE7FD;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>


            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250" x:Name="ColProperties"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource SideBarColor}">
                <StackPanel>
                    <ToggleButton Style="{StaticResource ActivityBarToggleStyle}" 
                                  Content="&#xE8B7;" ToolTip="Explorador de Proyectos (Ctrl+Shift+E)"
                                  Click="ActivityBar_Click" Tag="Explorer"/>
                    <ToggleButton Style="{StaticResource ActivityBarToggleStyle}" 
                                  Content="&#xe152;" ToolTip="Caja de Herramientas (Ctrl+Shift+X)"
                                  Click="ActivityBar_Click" Tag="Toolbox"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Width="1" Background="{StaticResource BorderColor}"/>
            </Grid>

            <Grid Grid.Column="1" x:Name="SideBarContainer" Background="{StaticResource SideBarColor}" Width="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="SideBarTitle" 
                           Text="EXPLORADOR" Foreground="{StaticResource MutedTextColor}" 
                           FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>

                <ContentControl Grid.Row="1" x:Name="SideBarContent" Margin="10">
                    <TextBlock Text="Contenido del panel..." Foreground="#888888"/>
                </ContentControl>

                <Border Grid.RowSpan="2" HorizontalAlignment="Right" Width="1" Background="{StaticResource BorderColor}"/>
            </Grid>

            <Grid Grid.Column="2" Background="{StaticResource BgColor}">
                <Grid x:Name="EmptyStateOverlay" Panel.ZIndex="0">
                    <TextBlock Text="&#xE70C;" FontFamily="Segoe MDL2 Assets" 
                               FontSize="150" Foreground="{StaticResource HoverColor}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Opacity="0.3"/>
                    <TextBlock Text="Selecciona un archivo del explorador para editar" 
                               Foreground="#666666" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,200,0,0"/>
                </Grid>

                <TabControl x:Name="MainTabControl" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="0"
                            ItemContainerStyle="{StaticResource VsCodeTabStyle}"
                            Visibility="Hidden"
                            MouseMove="Lienzo_MouseMove"
                            >
                </TabControl>
            </Grid>

            <Grid Grid.Column="3" x:Name="RightSidebarGrid" Background="#252526">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" x:Name="RightRow1"/>
                    <RowDefinition Height="5" x:Name="RightSplitterRow"/>
                    <RowDefinition Height="*" x:Name="RightRow2"/>
                </Grid.RowDefinitions>

                <local:PropertiesPanel x:Name="PropertiesPanel" 
                           Grid.Row="0"
                           BorderBrush="#3E3E42" 
                           BorderThickness="1,0,0,0"/>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#3E3E42" ResizeBehavior="PreviousAndNext"/>

                <Grid x:Name="SecondaryPanel" Grid.Row="2" Background="#2D2D30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Padding="5" BorderBrush="#3E3E42" BorderThickness="1,1,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Click="BtnCloseSecondary_Click" Width="16" Height="16" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#969696"/>
                            </Button>
                            <TextBlock Text="VISTA AUXILIAR" Foreground="#969696" FontSize="11" FontWeight="Bold"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Text="Aquí iría otro control..." Foreground="#666" 
                   VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="10"/>
                </Grid>

            </Grid>
        </Grid>

        <StatusBar Grid.Row="3" Background="#007ACC" Foreground="White" Padding="5,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBar.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="Margin" Value="10,0"/>
                </Style>

                <Style TargetType="Separator">
                    <Setter Property="Width" Value="1"/>
                    <Setter Property="Height" Value="14"/>
                    <Setter Property="Background" Value="#33FFFFFF"/>
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </StatusBar.Resources>

            <StatusBarItem Grid.Column="0" HorizontalContentAlignment="Stretch">
                <TextBlock Text="Listo" 
                   FontFamily="Segoe UI" 
                   Margin="5,0,0,0" />
            </StatusBarItem>

            <StatusBarItem Grid.Column="2">
                <TextBlock x:Name="txtCursorPos" Text="X: 0, Y: 0" />
            </StatusBarItem>

            <Separator Grid.Column="3" />

            <StatusBarItem Grid.Column="4">
                <TextBlock Text="UTF-8" />
            </StatusBarItem>

            <Separator Grid.Column="5" />

            <StatusBarItem Grid.Column="6">
                <TextBlock Text="INS" Opacity="0.8"/>
            </StatusBarItem>

            <Separator Grid.Column="7" />

            <StatusBarItem Grid.Column="8" Margin="5,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="100%" Margin="0,0,5,0" Width="35" TextAlignment="Right"/>
                    <Slider Width="80" 
                    VerticalAlignment="Center" 
                    Minimum="20" 
                    Maximum="200" 
                    Value="100"
                    IsSnapToTickEnabled="True"
                    TickFrequency="10">
                        <Slider.Style>
                            <Style TargetType="Slider">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Slider">
                                            <Grid VerticalAlignment="Center">
                                                <Border Height="2" Background="#55FFFFFF" CornerRadius="1"/>
                                                <Track x:Name="PART_Track">
                                                    <Track.Thumb>
                                                        <Thumb Width="10" Height="10">
                                                            <Thumb.Template>
                                                                <ControlTemplate>
                                                                    <Ellipse Fill="White" Stroke="#007ACC" StrokeThickness="1"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Slider.Style>
                    </Slider>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
