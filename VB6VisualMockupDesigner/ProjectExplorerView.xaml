<UserControl x:Class="VB6VisualMockupDesigner.ProjectExplorerView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450" d:DesignWidth="250">
    <Grid Background="#252526">
        <StackPanel>
            <TextBlock Text="PROYECTO VB6" Foreground="#969696" FontSize="11" FontWeight="Bold" Margin="10,10,0,5"/>

            <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Foreground="#CCCCCC">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,3"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" Foreground="#005A9E"/>
                                            <ContentPresenter/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3E3E42"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#37373D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBoxItem Tag="frmMain.frm">frmMain.frm</ListBoxItem>
                <ListBoxItem Tag="frmLogin.frm">frmLogin.frm</ListBoxItem>
                <ListBoxItem Tag="frmFactura.frm">frmFactura.frm</ListBoxItem>
            </ListBox>
        </StackPanel>
    </Grid>
</UserControl>
