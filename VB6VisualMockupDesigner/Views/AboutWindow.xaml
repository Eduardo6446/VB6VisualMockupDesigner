<Window x:Class="VB6VisualMockupDesigner.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de VB6 Mockup Studio" 
        Height="320" Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        ResizeMode="NoResize"
        Icon="/Resource/icon.ico"
        Background="{DynamicResource AppBackground}" 
        BorderBrush="{DynamicResource BrandColor}" 
        BorderThickness="1"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Content="✕" 
                HorizontalAlignment="Right"
                Width="40" Height="30"
                Click="BtnClose_Click"
                WindowChrome.IsHitTestVisibleInChrome="True">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Grid Grid.Row="1" Margin="25,10,25,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="AppLogo"
                   Source="/Resource/icon.ico" 
                   Width="80" Height="80"
                   VerticalAlignment="Top"
                   Margin="0,10,20,0"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   MouseLeftButtonDown="AppLogo_MouseDoubleClick"
                   Cursor="Help"
                   ToolTip="Doble click para ver magia...">
                <Image.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="5" Opacity="0.5"/>
                </Image.Effect>
            </Image>

            <StackPanel Grid.Column="1">
                <TextBlock Text="VB6 Mockup Studio" 
                           Foreground="{DynamicResource PrimaryText}" 
                           FontSize="26" 
                           FontFamily="Segoe UI Light"
                           Margin="0,0,0,5"/>

                <TextBlock Text="Versión 0.9.15 (Build 2026)" 
                           Foreground="{DynamicResource BrandColor}" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Herramienta de modernización y prototipado rápido." 
                           Foreground="{DynamicResource SecondaryText}" 
                           TextWrapping="Wrap"
                           Margin="0,0,0,5"/>

                <TextBlock Text="© 2026 Eduardo Orozco / Grupo SyntexNic" 
                           Foreground="{DynamicResource SecondaryText}" 
                           Opacity="0.7"
                           FontSize="12"/>

                <Separator Background="{DynamicResource BorderBrush}" Margin="0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Entorno:" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Memoria:" Foreground="{DynamicResource SecondaryText}" FontSize="11" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text=".NET 8.0 - Windows 11" Foreground="{DynamicResource SecondaryText}" FontSize="11"/>
                        <TextBlock x:Name="txtMemory" Text="Calculando..." Foreground="#4CAF50" FontSize="11" Margin="0,2,0,0" FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="System Info..." 
                        HorizontalAlignment="Left"
                        Padding="10,4"
                        Background="Transparent"
                        Foreground="{DynamicResource SecondaryText}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Click="BtnSysInfo_Click"/>


                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock Text="Hecho con ♥ y WPF" 
                               VerticalAlignment="Center" 
                               Foreground="{DynamicResource SecondaryText}" 
                               Margin="0,0,20,0" 
                               FontSize="11" 
                               FontStyle="Italic"
                               FontFamily="Segoe UI"/>

                    <Button Content="Aceptar" 
                            Width="90" 
                            Height="26"
                            Background="{DynamicResource BrandColor}"
                            Foreground="White"
                            BorderThickness="0"
                            Click="BtnClose_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="0"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>