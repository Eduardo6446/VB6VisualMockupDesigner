<Window x:Class="VB6VisualMockupDesigner.Views.FontPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:VB6VisualMockupDesigner.Converters"
        Title="Seleccionar Fuente" 
        Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource HeaderBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                       FontSize="10"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/> <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <converters:FontFamilyToNameConverter x:Key="FontNameConverter"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource PanelBackground}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/> <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/> </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource HeaderBackground}">
                <TextBlock Text="Seleccionar Fuente" 
                           VerticalAlignment="Center" 
                           Margin="10,0,0,0" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryText}"/>
                
                <Button x:Name="BtnCloseWindow" 
                        Style="{StaticResource WindowCloseButtonStyle}"
                        Width="40" Height="32" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top"
                        Click="BtnCloseWindow_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderBrush}"/>

            <Grid Grid.Row="1" Grid.RowSpan="5" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> 
                    <RowDefinition Height="*"/>    
                    <RowDefinition Height="Auto"/> 
                    <RowDefinition Height="Auto"/> 
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.RowSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Familia de Fuente" Style="{StaticResource LabelText}"/>
                            <Button x:Name="BtnImport" Content="Importar..." Click="BtnImport_Click" 
                                    FontSize="11" Padding="6,2" Height="22"
                                    Background="Transparent" Foreground="{DynamicResource BrandColor}" 
                                    BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBox x:Name="TxtFont" IsReadOnly="True" Margin="0,0,0,5"/>
                        <ListBox x:Name="LstFonts" Height="190" SelectionChanged="LstFonts_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ., Converter={StaticResource FontNameConverter}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Estilo" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="TxtStyle" IsReadOnly="True" Margin="0,0,0,5"/>
                        <ListBox x:Name="LstStyles" Height="190" SelectionChanged="LstStyles_SelectionChanged">
                            <ListBoxItem Content="Normal" Tag="Regular"/>
                            <ListBoxItem Content="Cursiva" Tag="Italic" FontStyle="Italic"/>
                            <ListBoxItem Content="Negrita" Tag="Bold" FontWeight="Bold"/>
                            <ListBoxItem Content="Negrita Cursiva" Tag="BoldItalic" FontWeight="Bold" FontStyle="Italic"/>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Tamaño" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="TxtSize" Text="{Binding SelectedItem, ElementName=LstSizes}" Margin="0,0,0,5"/>
                        <ListBox x:Name="LstSizes" Height="190" SelectionChanged="LstSizes_SelectionChanged"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Efectos" Padding="10" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource SecondaryText}">
                        <StackPanel>
                            <CheckBox x:Name="ChkStrike" Content="Tachado" Margin="0,0,0,8" Click="Effect_Click" Foreground="{DynamicResource PrimaryText}"/>
                            <CheckBox x:Name="ChkUnderline" Content="Subrayado" Click="Effect_Click" Foreground="{DynamicResource PrimaryText}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Vista Previa" Padding="0" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource SecondaryText}">
                        <Border Background="{DynamicResource HeaderBackground}" Margin="5">
                            <TextBlock x:Name="LblPreview" Text="AaBbYyZz" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryText}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </GroupBox>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Aceptar" IsDefault="True" Width="90" Height="30" Margin="0,0,10,0" Click="BtnOk_Click" 
                            Background="{DynamicResource BrandColor}" Foreground="White" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Cancelar" IsCancel="True" Width="90" Height="30" Click="BtnCancel_Click"
                            Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Foreground="{DynamicResource PrimaryText}">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>