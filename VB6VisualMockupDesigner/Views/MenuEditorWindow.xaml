<Window x:Class="VB6VisualMockupDesigner.Views.MenuEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de Menús" 
        Height="450" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrandColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Caption:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox x:Name="TxtCaption" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" TextChanged="Input_Changed"/>

            <TextBlock Text="Name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox x:Name="TxtName" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" TextChanged="Input_Changed"/>

            <TextBlock Text="Index:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox x:Name="TxtIndex" Grid.Row="2" Grid.Column="1" Width="60" HorizontalAlignment="Left" Margin="0,0,0,10" />

            <TextBlock Text="Shortcut:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10"/>
            <ComboBox x:Name="CboShortcut" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Width="150" Margin="0,0,0,10"
                      Background="{DynamicResource PanelBackground}" Foreground="Black">
                <ComboBoxItem Content="(None)"/>
                <ComboBoxItem Content="Ctrl+A"/>
                <ComboBoxItem Content="Ctrl+B"/>
                <ComboBoxItem Content="Ctrl+C"/>
            </ComboBox>

            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox x:Name="ChkChecked" Content="Checked" Foreground="{DynamicResource PrimaryText}" Margin="0,0,15,0" Click="Input_Changed"/>
                <CheckBox x:Name="ChkEnabled" Content="Enabled" IsChecked="True" Foreground="{DynamicResource PrimaryText}" Margin="0,0,15,0" Click="Input_Changed"/>
                <CheckBox x:Name="ChkVisible" Content="Visible" IsChecked="True" Foreground="{DynamicResource PrimaryText}" Click="Input_Changed"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="Siguiente" Click="BtnNext_Click"/>
                <Button Content="Insertar" Click="BtnInsert_Click"/>
                <Button Content="Eliminar" Click="BtnDelete_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnLeft" Content="&#xE09E;" ToolTip="Desindentar (Subir nivel)" Click="BtnLeft_Click" Style="{StaticResource IconButtonStyle}"/>
                <Button x:Name="BtnRight" Content="&#xE09F;" ToolTip="Indentar (Hacer submenú)" Click="BtnRight_Click" Style="{StaticResource IconButtonStyle}"/>
                <Button x:Name="BtnUp" Content="&#xE0A0;" ToolTip="Mover Arriba" Click="BtnUp_Click" Style="{StaticResource IconButtonStyle}" Margin="10,2,2,2"/>
                <Button x:Name="BtnDown" Content="&#xE0A1;" ToolTip="Mover Abajo" Click="BtnDown_Click" Style="{StaticResource IconButtonStyle}"/>
            </StackPanel>
        </Grid>

        <ListBox x:Name="LstMenu" Grid.Row="2" 
                 Background="{DynamicResource PanelBackground}" 
                 BorderBrush="{DynamicResource BorderBrush}"
                 Foreground="{DynamicResource PrimaryText}"
                 DisplayMemberPath="DisplayCaption"
                 SelectionChanged="LstMenu_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="5,2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentColor}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Aceptar" IsDefault="True" Click="BtnOk_Click" Width="80" Height="28" Margin="0,0,10,0" Background="{DynamicResource BrandColor}" Foreground="White" BorderThickness="0"/>
            <Button Content="Cancelar" IsCancel="True" Click="BtnCancel_Click" Width="80" Height="28"/>
        </StackPanel>

    </Grid>
</Window>