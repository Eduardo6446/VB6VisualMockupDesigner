<Window x:Class="VB6VisualMockupDesigner.Views.MenuEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de Menús" 
        Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource PanelBackground}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrandColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" 
                                       FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{DynamicResource HeaderBackground}" 
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Editor de Menús" 
                           Foreground="{DynamicResource PrimaryText}" 
                           VerticalAlignment="Center" 
                           Margin="10,0,0,0" 
                           FontSize="12" FontWeight="SemiBold"/>

                <Button HorizontalAlignment="Right" 
                        Style="{StaticResource WindowCloseButtonStyle}"
                        Click="BtnCancel_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Caption:" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtCaption" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" TextChanged="Input_Changed"/>

            <TextBlock Text="Name:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtName" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" TextChanged="Input_Changed"/>

            <TextBlock Text="Index:" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtIndex" Grid.Row="2" Grid.Column="1" Width="60" HorizontalAlignment="Left" Margin="0,0,0,8" />

            <TextBlock Text="Shortcut:" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <ComboBox x:Name="CboShortcut" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Width="150" Margin="0,0,0,8"
                      Style="{DynamicResource PropComboStyle}">
                <ComboBoxItem Content="(None)"/>
                <ComboBoxItem Content="Ctrl+A"/>
                <ComboBoxItem Content="Ctrl+B"/>
                <ComboBoxItem Content="Ctrl+C"/>
                <ComboBoxItem Content="Ctrl+D"/>
                <ComboBoxItem Content="Ctrl+E"/>
                <ComboBoxItem Content="Ctrl+F"/>
                <ComboBoxItem Content="Ctrl+G"/>
                <ComboBoxItem Content="Ctrl+H"/>
                <ComboBoxItem Content="Ctrl+I"/>
                <ComboBoxItem Content="Ctrl+J"/>
                <ComboBoxItem Content="Ctrl+K"/>
                <ComboBoxItem Content="F1"/>
                <ComboBoxItem Content="F2"/>
                <ComboBoxItem Content="F3"/>
                <ComboBoxItem Content="F4"/>
                <ComboBoxItem Content="F5"/>
            </ComboBox>

            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <CheckBox x:Name="ChkChecked" Content="Checked" Foreground="{DynamicResource PrimaryText}" Margin="0,0,15,0" Click="Input_Changed"/>
                <CheckBox x:Name="ChkEnabled" Content="Enabled" IsChecked="True" Foreground="{DynamicResource PrimaryText}" Margin="0,0,15,0" Click="Input_Changed"/>
                <CheckBox x:Name="ChkVisible" Content="Visible" IsChecked="True" Foreground="{DynamicResource PrimaryText}" Click="Input_Changed"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="15,0,15,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="Siguiente" Click="BtnNext_Click"/>
                <Button Content="Insertar" Click="BtnInsert_Click"/>
                <Button Content="Eliminar" Click="BtnDelete_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnLeft" Content="&#xE09E;" ToolTip="Desindentar" Click="BtnLeft_Click" Style="{StaticResource IconButtonStyle}"/>
                <Button x:Name="BtnRight" Content="&#xE09F;" ToolTip="Indentar" Click="BtnRight_Click" Style="{StaticResource IconButtonStyle}"/>
                <Button x:Name="BtnUp" Content="&#xE0A0;" ToolTip="Subir" Click="BtnUp_Click" Style="{StaticResource IconButtonStyle}" Margin="10,2,2,2"/>
                <Button x:Name="BtnDown" Content="&#xE0A1;" ToolTip="Bajar" Click="BtnDown_Click" Style="{StaticResource IconButtonStyle}"/>
            </StackPanel>
        </Grid>

        <ListBox x:Name="LstMenu" Grid.Row="3" Margin="15,0,15,0"
                 Background="{DynamicResource HeaderBackground}" 
                 BorderBrush="{DynamicResource BorderBrush}"
                 Foreground="{DynamicResource PrimaryText}"
                 DisplayMemberPath="DisplayCaption"
                 SelectionChanged="LstMenu_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="5,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="2">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandColor}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15">
            <Button Content="Aceptar" IsDefault="True" Click="BtnOk_Click" Width="80" Height="28" Margin="0,0,10,0" 
                    Background="{DynamicResource BrandColor}" Foreground="White" BorderThickness="0"/>
            <Button Content="Cancelar" IsCancel="True" Click="BtnCancel_Click" Width="80" Height="28"/>
        </StackPanel>

    </Grid>
</Window>