<UserControl x:Class="VB6VisualMockupDesigner.Views.ProjectExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:VB6VisualMockupDesigner.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="250"
             FontFamily="Segoe UI"
             AllowDrop="True"
          DragOver="ProjectTree_DragOver"
          Drop="ProjectTree_Drop"
             >

    <UserControl.Resources>

        <Style x:Key="ExplorerBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="ItemContextMenu">
            <MenuItem Header="Abrir Diseñador" Click="MnuOpen_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Nuevo Archivo..." Click="MnuNewFileContext_Click"/>
            <MenuItem Header="Nueva Carpeta..." Click="MnuNewFolderContext_Click"/>
            <Separator/>
            <MenuItem Header="Renombrar" InputGestureText="F2" Click="MnuRename_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Eliminar" InputGestureText="Supr" Click="MnuDelete_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="Red"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Revelar en el Explorador" Click="MnuReveal_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xEC50;" FontFamily="Segoe MDL2 Assets"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <HierarchicalDataTemplate x:Key="ExplorerItemTemplate" ItemsSource="{Binding Children}" DataType="{x:Type models:ExplorerItem}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding IconCode}" 
                       FontFamily="Segoe MDL2 Assets" 
                       Foreground="{DynamicResource BrandColor}" 
                       Margin="0,0,6,0" 
                       VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" 
                       Foreground="{DynamicResource PrimaryText}" 
                       FontSize="13"
                       VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>

            <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}"/>

            <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MinWidth="19" Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="Expander" ClickMode="Press" 
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <TextBlock x:Name="Arrow" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" 
                                                           Foreground="#888888" FontSize="10" VerticalAlignment="Center" Margin="4,0"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Arrow" Property="Text" Value="&#xE70D;"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <Border x:Name="Bd" Grid.Column="1" Grid.ColumnSpan="2" 
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Left"/>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2D2E"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#37373D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=TreeView}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource PanelBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="EXPLORADOR" Foreground="#666666" 
                   FontSize="11" FontWeight="Bold" 
                   VerticalAlignment="Center" Margin="10,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,5,0">
                <Button Style="{StaticResource ExplorerBtnStyle}" ToolTip="Nuevo Archivo" Click="BtnNewFile_Click">
                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#444444"/>
                </Button>

                <Button Style="{StaticResource ExplorerBtnStyle}" ToolTip="Nueva Carpeta" Click="BtnNewFolder_Click">
                    <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#444444"/>
                </Button>

                <Button Style="{StaticResource ExplorerBtnStyle}" ToolTip="Colapsar Todo" Click="BtnCollapseAll_Click">
                    <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#444444"/>
                </Button>
            </StackPanel>
        </Grid>

        <TreeView x:Name="ProjectTree" 
                  Grid.Row="1"
                  Background="Transparent" 
                  BorderThickness="0" 
                  ItemTemplate="{StaticResource ExplorerItemTemplate}"
                  SelectedItemChanged="ProjectTree_SelectedItemChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="ProjectTree_MouseDoubleClick"
          PreviewKeyDown="ProjectTree_PreviewKeyDown"
                  >
        </TreeView>
    </Grid>
</UserControl>