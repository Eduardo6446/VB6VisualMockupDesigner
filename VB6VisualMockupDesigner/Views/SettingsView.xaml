<UserControl x:Class="VB6VisualMockupDesigner.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}" 
             Foreground="{DynamicResource PrimaryText}"
             Height="450" Width="600">

    <UserControl.Resources>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" 
                Content="✕" 
                HorizontalAlignment="Right"
                Width="40" Height="30"
                Click="BtnClose_Click"
                Style="{StaticResource CloseButtonStyle}"/>

        <Grid Grid.Row="1" Margin="30,0,30,30">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                <TextBlock Text="Configuración" 
                           FontSize="28" FontWeight="Light" 
                           Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,20"/>

                <TextBlock Text="Apariencia" 
                           FontSize="18" FontWeight="SemiBold" 
                           Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"/>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Tema del Editor:" 
                               VerticalAlignment="Center" 
                               Width="120" Foreground="{DynamicResource SecondaryText}"/>

                    <ComboBox x:Name="CboThemes" Width="200" Padding="6">
                        <ComboBoxItem Content="Modo Oscuro (VS Code)" Tag="Dark"/>
                        <ComboBoxItem Content="Modo Claro" Tag="Light"/>
                        <ComboBoxItem Content="Clásico VB6 (Grid)" Tag="VB6"/>
                        <ComboBoxItem Content="Personalizado" Tag="Custom"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Text="Editor" 
                           FontSize="18" FontWeight="SemiBold" 
                           Foreground="{DynamicResource AccentColor}" Margin="0,20,0,10"/>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,15"/>

                <CheckBox Content="Mostrar números de línea (Simulado)" 
                          Foreground="{DynamicResource PrimaryText}"
                          IsChecked="True" Margin="0,5"/>
                <CheckBox Content="Auto-guardar al ejecutar" 
                          Foreground="{DynamicResource PrimaryText}"
                          Margin="0,5"/>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>